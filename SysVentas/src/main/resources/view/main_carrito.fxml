<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.controller.CompCarritoController">

    <Label layoutX="50.0"
           layoutY="30.0"
           text="GESTIONAR CARRITO"
           style="-fx-font-size: 24px;"/>

    <Label layoutX="50.0"
           layoutY="90.0"
           text="Nombre del producto:"/>

    <TextField fx:id="txtNombreProducto"
               layoutX="200.0"
               layoutY="85.0"
               prefWidth="250.0"/>

    <Label layoutX="50.0"
           layoutY="140.0"
           text="Cantidad:"/>

    <TextField fx:id="txtCantidad"
               layoutX="200.0"
               layoutY="135.0"
               prefWidth="250.0"/>

    <Label layoutX="50.0"
           layoutY="190.0"
           text="Precio unitario:"/>

    <TextField fx:id="txtPUnitario"
               layoutX="200.0"
               layoutY="185.0"
               prefWidth="250.0"/>

    <Button layoutX="200.0"
            layoutY="240.0"
            text="GUARDAR"
            onAction="#guardar"/>

    <Label fx:id="lbnMsg"
           layoutX="50.0"
           layoutY="300.0"
           prefWidth="500.0"
           style="-fx-font-size: 16px;"/>

</AnchorPane>